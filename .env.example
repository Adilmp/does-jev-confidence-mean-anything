# Copy to .env and fill in, or just export these in your shell.
# Do not commit the real .env.

JEV_API_KEY=sk-your-key-here

# Optional. Defaults are in jev.py.
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest          # pin to a version (e.g. jev-1.13.0) for a
#                               # reproducible run - "latest" can drift under you
# JEV_WORKERS=8                 # parallel requests; lower this if you get 429s
